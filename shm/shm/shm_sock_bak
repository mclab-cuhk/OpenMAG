void shm_init_global(shm_config_t config){
    init_shm_names(config.mode);

    tctx = (shm_global_t*)malloc(sizeof(shm_global_t));
    for (int i = 0; i < config.max_conn; i++) {
        tctx->connections.write_entries[i].fd = -1;
        tctx->connections.write_entries[i].socket = NULL;
        conn[i] = -1;
    }
    tctx->connections.count = 0;
    tctx->total_conn = config.max_conn;
    struct group *grp = getgrnam("openvpn");
    if (grp == NULL) {
        perror("getgrnam failed");
        exit(1);
    }
    openvpn_gid = grp->gr_gid;
    // 注册信号处理函数
    signal(SIGINT, cleanup_shared_memory);
    signal(SIGTERM, cleanup_shared_memory);
}

/**
 * @brief This function is used to create a new socket in the shared memory.
 * 
 * @param domain The domain of the socket.
 * @param shm_size The size of the shared memory.
 * @param protocol The protocol of the socket.
 * @return int The file descriptor of the new socket.
 */
int shm_socket(int domain, int shm_size, int protocol) {
    // Open or create shared memory object
    char name[30];
    
    snprintf(name, sizeof(name), "socket_%d", domain);

    // Initialize shm_socket_t structure
    shm_socket_t *s = alloc_new_sock(NULL);
    
    memcpy(s->name, name, sizeof(name));

    void *buf_ptr = alloc_shared_memory(name, shm_size, s);
    
    if (buf_ptr == NULL) {
        perror("shared memory mmap failed!\n");
        return -1;
    }

    s->buffer.ptr = buf_ptr;
    s->buffer.capacity = shm_size;

    // Add new socket to global connection table
    tctx->connections.write_entries[domain].fd = s->fd;
    tctx->connections.write_entries[domain].socket = s;
    //tctx->connections.count++;

    return domain;
}

int shm_connect(int fd, const char *addr, socklen_t addrlen) {
    // Get global structure
    shm_global_t *global = shm_get_global();
    if (global == NULL) {
        perror("Failed to get global structure");
        return -1;
    }

    // Check if fd is valid
    if (fd < 0 || fd > global->total_conn) {
        errno = EBADF;
        return errno;
    }

    // Get corresponding socket
    shm_socket_t *s = global->connections.write_entries[fd].socket;
    if (s == NULL) {
        errno = ENOTSOCK;
        return errno;
    }

    // Check if address length is valid
    if (addrlen > s->buffer.capacity) {
        errno = EINVAL;
        return errno;
    }

    // Set connection status to connecting
    atomic_store(&s->status, 0);

    // Write entire shm_socket_t structure to shared memory
    ssize_t woff = s->buffer.write_offset;
    s->buffer.write_offset += sizeof(shm_socket_t);
    memcpy((char *)s->buffer.ptr + woff, s, sizeof(shm_socket_t));

    printf("Alloc new socket %p of connection %d, share ptr is %p!\n", s, fd, s->buffer.ptr);

    // Open shared memory created by server
    // Construct server shared memory name
    char srv_shm_name[32];
    snprintf(srv_shm_name, sizeof(srv_shm_name), "socket_%d", 0);

    void *srv_shm_ptr = read_shared_memory(srv_shm_name);

    // First read backlog value
    int *backlog_ptr = (int *)(srv_shm_ptr);
    int backlog = *backlog_ptr;

    // Get shm_socket_t structure
    shm_socket_t *listen_socket = (shm_socket_t *)((char *)backlog_ptr + sizeof(int));

    // After backlog and shm_socket_t structure, take out int length area to fill fd
    int *fd_ptr = (int *)((char *)listen_socket + sizeof(shm_socket_t));
    atomic_store(fd_ptr, fd);
    
    LOG_INFO(__func__,"Client fd %d has been written to client shared memory, backlog: %d\n", fd, backlog);

    // Calculate position of conn array
    int *conn = (int *)((char *)fd_ptr + sizeof(int));

    // Check if there is still space to store new fd
    if (backlog > 0) {
        atomic_store(conn + fd, 0);
        atomic_fetch_add(backlog_ptr, 1);
    } else {
        LOG_ERROR(__func__,"Warning: Server socket shared memory is full, unable to store new client connection status");
    }
    
    // Set server socket status to new connection
    atomic_store(&listen_socket->status, 0);
    
    LOG_INFO(__func__,"Server socket status set to new connection");

    LOG_INFO(__func__,"conn %p 当前状态: %d", &conn, atomic_load(conn + fd));

    // Wait for connection to be established
    int timeout = 30000; // 30 seconds timeout
    while (atomic_load(conn + fd) == 0 && timeout > 0) {
        usleep(1000);  // Sleep for 1 millisecond
        timeout--;
    }

    if (atomic_load(conn + fd) == 1) {
        char srv_name[32];
        snprintf(srv_name, sizeof(srv_name), "srv_buf_%d", fd);
        void *read_ptr = read_shared_memory(srv_name);
        shm_socket_t *new_socket = (shm_socket_t*)read_ptr;
        if (new_socket == NULL) {
            perror("Failed to create new socket");
            return -1;
        }
        global->connections.read_entries[fd].fd = fd;
        global->connections.read_entries[fd].socket = new_socket;
        new_socket->buffer.read_offset = sizeof(shm_socket_t);
        global->connections.count++;
        LOG_INFO(__func__,"Connection successfully established");
        return 0;
    } else if (timeout == 0) {
        errno = ETIMEDOUT;
        LOG_INFO(__func__,"Connection timed out");
        return errno;
    } else {
        errno = ECONNREFUSED;
        LOG_INFO(__func__,"Connection refused");
        return errno;
    }
}

