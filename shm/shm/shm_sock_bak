void cleanup_shared_memory(int signum) {
    LOG_INFO(__func__,"Cleaning shared memory...");
    
    // 清理所有连接的共享内存
    for (int i = 0; i < MAX_CONNECTIONS; i++) {
        shm_close(i);
    }
    
     // 解除映射并关闭全局共享内存
    if (tctx != NULL) {
        free(tctx);
    }

    LOG_INFO(__func__,"Shared memory is cleaned up.");
    exit(signum);
}

void *alloc_shm(const char *name, size_t size) {
    int shm_fd = shm_open(name, O_CREAT | O_RDWR | O_TRUNC, 0666);
    if (shm_fd == -1) {
        perror("Unable to create shared memory");
        return NULL;
    }

    if (ftruncate(shm_fd, size) == -1) {
        perror("Unable to set size of shared memory");
        close(shm_fd);
        return NULL;
    }

    void *ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
    if (ptr == MAP_FAILED) {
        perror("Unable to map shared memory");
        close(shm_fd);
        return NULL;
    }

    return ptr;
}

void *read_shm(const char *name) {
    int shm_fd = shm_open(name, O_RDWR, 0660);
    if (shm_fd == -1) {
        perror("Unable to open shared memory");
        return NULL;
    }

    struct stat sb;
    if (fstat(shm_fd, &sb) == -1) {
        perror("Unable to get size of shared memory");
        close(shm_fd);
        return NULL;
    }

    void *ptr = mmap(NULL, sb.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
    if (ptr == MAP_FAILED) {
        perror("Unable to map shared memory");
        close(shm_fd);
        return NULL;
    }

    return ptr;
}

size_t parse_size(const char *str) {
    char *endptr;
    size_t size = strtoull(str, &endptr, 10);
    
    while (isspace(*endptr)) endptr++;
    
    if (*endptr == 'g' || *endptr == 'G') {
        size *= 1024 * 1024 * 1024;
    } else if (*endptr == 'm' || *endptr == 'M') {
        size *= 1024 * 1024;
    } else if (*endptr == 'k' || *endptr == 'K') {
        size *= 1024;
    } else if (*endptr != '\0') {
        LOG_ERROR(__func__,"Invalid size format: %s", str);
        exit(1);
    }
    
    return size;
}

void *alloc_shared_memory(const char *name, size_t size, shm_socket_t* s) {
    int shm_fd = shm_open(name, O_CREAT | O_RDWR | O_TRUNC, 0660);
    if (shm_fd == -1) {
        perror("Unable to create shared memory");
        return NULL;
    }

    if (fchown(shm_fd, -1, openvpn_gid) == -1) {
        perror("fchown failed");
        close(shm_fd);
        shm_unlink(name);
        return NULL;
    }

    if (fchmod(shm_fd, 0660) == -1) {
        LOG_ERROR(__func__,"fchmod failed for %s, error code: %d", name, errno);
        close(shm_fd); // 清理
        shm_unlink(name); // 清理
        return NULL; // <--- 我把这里也改成了 NULL，因为函数应该返回 void*
    }

    if (ftruncate(shm_fd, size) == -1) {
        perror("Unable to set size of shared memory");
        close(shm_fd);
        return NULL;
    }

    void *ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
    if (ptr == MAP_FAILED) {
        perror("Unable to map shared memory");
        close(shm_fd);
        return NULL;
    }

    if(s){
        s->fd = shm_fd;
    }

    return ptr;
}

