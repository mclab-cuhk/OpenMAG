int shm_bind(int fd, const char *addr, socklen_t addrlen) {
    // Store address information at the beginning of shared memory
    shm_global_t *global = shm_get_global();
    if (global == NULL) {
        perror("Failed to get global structure");
        return -1;
    }

    shm_socket_t *s = global->connections.write_entries[fd].socket;
    if (s == NULL) {
        errno = ENOTSOCK;
        return -1;
    }

    if (addrlen > 256) {
        return -1;  // Address is too long to store
    }
    
    strncpy(s->name, addr, addrlen);
    return 0;
}

int shm_listen(int fd, int backlog) {
    // Store the backlog value in shared memory
    // We assume bind() has been called, so we start writing after the global structure
    // Get shm_global_t structure from "tctx"
    shm_global_t *global = shm_get_global();
    if (global == NULL) {
        perror("Failed to get global structure");
        return -1;
    }
    // Check if fd is valid
    if (fd < 0 || fd > global->connections.count) {
        errno = EBADF;
        return errno;
    }

    // Get corresponding socket
    shm_socket_t *s = global->connections.write_entries[fd].socket;
    if (s == NULL) {
        errno = ENOTSOCK;
        return errno;
    }

    // Check backlog parameter
    if (backlog < 0) {
        errno = EINVAL;
        return errno;
    }

    // Mark socket as passive
    s->is_passive = true;

    // Store backlog value in shared memory
    if (sizeof(int) > s->buffer.capacity - s->buffer.write_offset) {
        errno = ENOMEM;
        return errno;  // Not enough space
    }

    *(int *)((char *)s->buffer.ptr + s->buffer.write_offset) = backlog;
    s->buffer.write_offset += sizeof(int);

    // Store s in shared memory
    memcpy((char *)s->buffer.ptr + s->buffer.write_offset, s, sizeof(shm_socket_t));
    s->buffer.write_offset += sizeof(shm_socket_t);

    // Reserve int length in shared memory, initial value is -1
    int reserved_value = -1;
    if (sizeof(int) > s->buffer.capacity - s->buffer.write_offset) {
        errno = ENOMEM;
        return errno;  // Not enough space
    }
    memcpy((char *)s->buffer.ptr + s->buffer.write_offset, &reserved_value, sizeof(int));
    s->buffer.write_offset += sizeof(int);

    // Store conn array in shared memory
    memcpy((char *)s->buffer.ptr + s->buffer.write_offset, conn, sizeof(conn));
    s->buffer.write_offset += sizeof(conn);

    // Update socket status to listening
    atomic_store(&s->status, -1); 

    LOG_INFO(__func__,"Socket %d is now listening with backlog %d", fd, backlog);

    return 0;
}

int shm_accept(int fd, struct sockaddr *addr, socklen_t *addrlen) {
    shm_global_t *global = shm_get_global();
    if (global == NULL) {
        perror("Failed to get global structure");
        return -1;
    }

    // Check if fd is valid
    if (fd < 0 || fd > global->connections.count) {
        errno = EBADF;
        LOG_ERROR(__func__,"Error: Invalid file descriptor %d. Error code: %d", fd, errno);
        return -1;
    }

    // Get corresponding listening socket
    shm_socket_t *listen_socket = global->connections.write_entries[fd].socket;
    if (listen_socket == NULL || !listen_socket->is_passive) {
        LOG_ERROR(__func__,"Error: Invalid listen socket %p. Error code: %d", listen_socket, errno);
        errno = EINVAL;
        return -1;
    }

    int *backlog_ptr = (int *)listen_socket->buffer.ptr;
    shm_socket_t *socket_ptr = (shm_socket_t *)((char *)backlog_ptr + sizeof(int));
    // Block and wait for connection request
    while (atomic_load(&socket_ptr->status) < 0) {
        LOG_DEBUG(__func__,"Global listen_socket %p 当前名称: %s", global->connections.write_entries[0].socket, listen_socket->name);
        LOG_DEBUG(__func__,"listen_socket %p 当前状态: %d", &socket_ptr, atomic_load(&socket_ptr->status));
        sleep(1);
        //usleep(1000);  // Sleep for 1 millisecond to avoid busy waiting
    }

    int new_fd = -1;

    if (atomic_load(&socket_ptr->status) == 0) {
        LOG_INFO(__func__,"New connection arrived, processing...\n");
        // Read fd value from listen_socket
        int *fd_ptr = (int *)((char *)socket_ptr + sizeof(shm_socket_t));

        new_fd = atomic_load(fd_ptr);

        // Construct client shared memory name based on new_fd
        char cli_shm_name[32];
        snprintf(cli_shm_name, sizeof(cli_shm_name), "socket_%d", new_fd);

        void *cli_shm_ptr = read_shm(cli_shm_name);

        // Create new socket for accepting connection
        shm_socket_t *new_socket = (shm_socket_t *)cli_shm_ptr;
        // Update read offset in the socket structure
        new_socket->buffer.read_offset = (new_socket->buffer.read_offset + sizeof(shm_socket_t)) % new_socket->buffer.capacity;
        if (new_socket == NULL) {
            perror("Failed to create new socket");
            return -1;
        }

        //shm_socket_t *new_socket = global->connections.entries[new_fd].socket;

        // If addr is not NULL, fill in client address information
        /*if (addr != NULL && addrlen != NULL) {
            socklen_t len = *addrlen < listen_socket->buffer.write_offset ? *addrlen : listen_socket->buffer.write_offset;
            memcpy(addr, (char *)listen_socket->buffer.ptr + sizeof(shm_global_t), len);
            *addrlen = len;
        }*/

        // Add new socket to global connection table
        if (global->connections.count < global->total_conn) {
            //global->connections.entries[new_fd].fd = new_fd;
            global->connections.read_entries[new_fd].socket = new_socket;

            char srv_name[32];
            shm_socket_t *srv_socket = alloc_new_sock(NULL);
            snprintf(srv_name, sizeof(srv_name), "srv_buf_%d", new_fd);
            size_t srv_wbuf_size = parse_size("20m");
            srv_socket->buffer.ptr = alloc_shared_memory(srv_name, srv_wbuf_size, NULL);
            srv_socket->fd = new_fd;
            srv_socket->buffer.capacity = srv_wbuf_size;
            srv_socket->buffer.write_offset += sizeof(shm_socket_t);
            memcpy(srv_socket->buffer.ptr, srv_socket, sizeof(shm_socket_t));

            global->connections.write_entries[new_fd].socket = srv_socket;

            global->connections.count++;
            // Take out conn array from buffer_ptr
            int *conn = (int *)((char *)fd_ptr + sizeof(int));
            // Set value at index new_fd to 1
            atomic_store(conn + new_fd, 1);
            atomic_store(&new_socket->status, 1);
            // Decrease backlog value by 1
            atomic_fetch_sub(backlog_ptr, 1);
            LOG_DETAIL(__func__, "conn %p 当前状态: %d", &conn, atomic_load(conn + new_fd));
            LOG_INFO(__func__, "New connection accepted, read socket=%p, write socket=%p, fd = %d, read = %zu, write = %zu.", 
                global->connections.read_entries[new_fd].socket, 
                global->connections.write_entries[new_fd].socket, 
                new_fd, 
                new_socket->buffer.read_offset, 
                new_socket->buffer.write_offset);
        } else {
            LOG_ERROR(__func__, "Warning: Maximum number of connections reached");
            shm_close(new_socket->fd);
            return -1;
        }

    }
    // Reset listening socket status
    atomic_store(&socket_ptr->status, -1);  // Assume -1 means ready to accept new connections
    return new_fd;
}

// Modify other functions to use the new structure
ssize_t shm_read(int fd, void *buf, size_t count) {
    shm_global_t *global = shm_get_global();
    if (fd <= 0 || fd > global->connections.count) {
        return -1; 
    }

    size_t available = 0;

    shm_socket_t *target_socket = NULL;

    size_t write_offset = 0;
    size_t read_offset = 0;

    time_t start_time = time(NULL);
    while(available == 0){
        target_socket = atomic_load_explicit(&global->connections.read_entries[fd].socket, memory_order_acquire);

        write_offset = atomic_load_explicit(&target_socket->buffer.write_offset, memory_order_acquire);
        read_offset = atomic_load_explicit(&target_socket->buffer.read_offset, memory_order_acquire);

        available = (write_offset - read_offset + target_socket->buffer.capacity) % target_socket->buffer.capacity;

        if(time(NULL) - start_time > 10){
            LOG_ERROR(__func__, "read timeout, available is %zu", available);
            break;
        }
    }

    if (count > available) {
        count = available;
    }

    char *writv_buf = ((char *)target_socket + target_socket->buffer.read_offset);

    LOG_DEBUG(__func__, "read_offset: %zu, write_offset: %zu, want %zu bytes, writv_buf: %p, buf: %p", target_socket->buffer.read_offset, target_socket->buffer.write_offset, count, writv_buf, buf);

    LOG_DETAIL(__func__,"Before read request buffer %p is %s in shm, read_offset is %zu, write_offset is %zu.\n", target_socket, (char *)target_socket + 80, target_socket->buffer.read_offset, target_socket->buffer.write_offset);
    
    if (target_socket->buffer.read_offset + count >= target_socket->buffer.capacity) {
        size_t first_part = target_socket->buffer.capacity - target_socket->buffer.read_offset;
        memcpy(buf, writv_buf, first_part);
        char *head_buf = ((char *)target_socket + sizeof(shm_socket_t));
        memcpy((char*)buf + first_part, head_buf, count - first_part);
        read_offset = (read_offset + count) % target_socket->buffer.capacity + sizeof(shm_socket_t);
    } else {
        memcpy(buf, writv_buf, count);
        read_offset = (read_offset + count) % target_socket->buffer.capacity;
    }
    atomic_store_explicit(&target_socket->buffer.read_offset, read_offset, memory_order_release);
    
    __sync_synchronize();

    LOG_DETAIL(__func__,"Connection %d buffer %p read request %s into shm, read_offset is %zu, write_offset is %zu.\n", fd, writv_buf, writv_buf, target_socket->buffer.read_offset, write_offset);
    return count; 
}


ssize_t shm_write(int fd, const void *buf, size_t count) {
    shm_global_t *global = shm_get_global();
    if (fd <= 0 || fd > global->connections.count) {
        LOG_ERROR(__func__, "fd is %d, total count is %d\n", fd, global->connections.count);
        return -1; 
    }

    shm_socket_t *s = atomic_load_explicit(&global->connections.write_entries[fd].socket, memory_order_acquire) ;
    if(s == NULL){
        LOG_ERROR(__func__, "shm_socket_t %d pointer is NULL\n", fd);
        return -1;
    }

    void *ptr = atomic_load_explicit(&s->buffer.ptr, memory_order_acquire);
    shm_socket_t *shm_socket_ptr = (shm_socket_t *)ptr;
    if(shm_socket_ptr == NULL){
        LOG_ERROR(__func__, "shm_socket_t %d shm pointer is NULL\n", fd);
        return -1;
    }
    s->buffer.read_offset = atomic_load_explicit(&shm_socket_ptr->buffer.read_offset, memory_order_acquire);
    
    size_t available = s->buffer.capacity - ((s->buffer.write_offset - s->buffer.read_offset + s->buffer.capacity) % s->buffer.capacity) - 1;
    
    if (count > available) {
        if (available == 0) {
            return -2; // 返回-2，表示缓冲区已满，需要等待
        }
        count = available;
    }
    ssize_t woff = s->buffer.write_offset;

    LOG_DETAIL(__func__,"Before write response buffer is %s in shm, read_offset is %zu, write_offset is %zu.\n", (char*)(s->buffer.ptr), s->buffer.read_offset, s->buffer.write_offset);

    if (woff + count >= s->buffer.capacity) {
        size_t first_part = s->buffer.capacity - s->buffer.write_offset;
        memcpy(s->buffer.ptr + woff, buf, first_part);
        memcpy(s->buffer.ptr + sizeof(shm_socket_t), (char*)buf + first_part, count - first_part);
        woff = (woff + count) % s->buffer.capacity + sizeof(shm_socket_t);
    } else {
        memcpy(s->buffer.ptr + woff, buf, count);
        woff = (woff + count) % s->buffer.capacity;
    }
    s->buffer.write_offset = woff;
    atomic_store_explicit(&shm_socket_ptr->buffer.write_offset, woff, memory_order_release);

    // Sync the written data to ensure it is visible to other processes
    /*if (msync(s->buffer.ptr, s->buffer.capacity, MS_SYNC) == -1) {
        perror("msync failed");
        return -1;
    }*/
    __sync_synchronize();
    
    LOG_DEBUG(__func__,"Connection %d buffer %p write request %s into shm, read_offset is %zu, write_offset is %zu.\n", fd, s->buffer.ptr + woff, (char*)(s->buffer.ptr + woff), s->buffer.read_offset, s->buffer.write_offset);
    return count;
}

int shm_close(int fd) {
    shm_global_t *global = shm_get_global();
    if (fd <= 0 || fd > global->connections.count) {
        return -1; 
    }

    shm_socket_t *s = global->connections.write_entries[fd].socket;
    if(s){
        atomic_store(&s->status, -2);
        
        for (int i = fd; i < global->connections.count; i++) {
            global->connections.write_entries[i] = global->connections.write_entries[i + 1];
        }
        global->connections.count--;

        munmap(s->buffer.ptr, s->buffer.capacity);
        close(s->fd);
        shm_unlink(s->name);
        free(s);
    }
    return 0;
}