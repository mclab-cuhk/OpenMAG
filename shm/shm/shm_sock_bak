shm_socket_t *alloc_new_sock(shm_socket_t *s){
    if(s == NULL)
        s = (shm_socket_t *)malloc(sizeof(shm_socket_t));
    s->fd = -1;
    s->status = -2;  // Initialize connection status to initial value
    s->buffer.ptr = NULL;
    s->buffer.read_offset = 0;
    s->buffer.write_offset = 0;
    s->buffer.capacity = -1;
    return s;
}

shm_config_t *read_config(const char *config_file) {
    shm_config_t *config = (shm_config_t *)malloc(sizeof(shm_config_t));
    FILE *file = fopen(config_file, "r");
    if (file == NULL) {
        LOG_ERROR("Unable to open config file: %s", config_file);
        exit(1);
    }

    char line[256];
    while (fgets(line, sizeof(line), file)) {
        char key[20], value[20];
        if (sscanf(line, "%s %s", key, value) == 2) {
            if (strcmp(key, "max_conn") == 0) {
                config->max_conn = atoi(value);
            } else if (strcmp(key, "mode") == 0) {
                if (strcmp(value, "client") == 0) {
                    config->mode = SHM_MODE_CLIENT;
                } else if (strcmp(value, "server") == 0) {
                    config->mode = SHM_MODE_SERVER;
                } else {
                    fprintf(stderr, "Invalid mode: %s\n", value);
                    exit(1);
                }
            } else if (strcmp(key, "shm_size") == 0) {
                config->shm_size = parse_size(value);
            }
        }
    }

    fclose(file);

    if (config->max_conn == 0 || (config->mode != SHM_MODE_CLIENT && config->mode != SHM_MODE_SERVER) || config->shm_size == 0) {
        LOG_ERROR(__func__,"Incomplete or invalid config file");
        exit(1);
    }

    return config;
}

void init_shm_names(shm_mode_t mode) {
    if (mode == SHM_MODE_CLIENT) {
        for (int i = 0; i < MAX_CONNECTIONS; i++) {
            snprintf(shm_names[i], sizeof(shm_names[i]), "cli_socket_%d", i);
        }
    } else if (mode == SHM_MODE_SERVER) {
        for (int i = 0; i < MAX_CONNECTIONS; i++) {
            snprintf(shm_names[i], sizeof(shm_names[i]), "srv_socket_%d", i);
        }
    } else {
        LOG_ERROR(__func__,"Error: Invalid mode");
        exit(1);
    }
}

